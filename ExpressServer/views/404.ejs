<section class="not-found-page">
  <div class="not-found-card reveal">
    <p class="eyebrow">404 Page Not Found</p>
    <h1 class="font-display">This route wandered off the map.</h1>
    <p>
      The page <span><%= requestedUrl %></span> does not exist. Try heading back home or choosing one of the main travel pages.
    </p>

    <div class="not-found-actions">
      <a class="primary-button" href="/">Go Home</a>
      <a class="secondary-button" href="/destinations">View Destinations</a>
    </div>
  </div>
</section>
