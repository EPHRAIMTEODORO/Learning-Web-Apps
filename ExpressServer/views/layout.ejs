<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-[#f6f4ec] text-[#20372f]">
  <header class="site-header">
    <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10">
      <a class="brand-mark" href="/">Student Travel Guide</a>
      <ul class="hidden items-center gap-8 text-sm font-semibold uppercase tracking-[0.22em] md:flex">
        <li><a class="nav-link <%= activePage === 'home' ? 'active' : '' %>" href="/">Home</a></li>
        <li><a class="nav-link <%= activePage === 'destinations' ? 'active' : '' %>" href="/destinations">Destinations</a></li>
        <li><a class="nav-link <%= activePage === 'gallery' ? 'active' : '' %>" href="/gallery">Gallery</a></li>
        <li><a class="nav-link <%= activePage === 'tips' ? 'active' : '' %>" href="/tips">Tips</a></li>
      </ul>
      <a class="nav-cta hidden md:inline-flex" href="<%= ctaHref %>"><%= ctaText %></a>
    </nav>
    <nav class="mobile-nav px-6 pb-5 md:hidden">
      <a href="/">Home</a>
      <a href="/destinations">Destinations</a>
      <a href="/gallery">Gallery</a>
      <a href="/tips">Tips</a>
    </nav>
  </header>

  <main>
    <%- body %>
  </main>

  <footer class="site-footer">
    <p>Student Travel Guide</p>
    <p>&copy; 2026. Built as a modern HTML, Tailwind, and CSS travel project.</p>
  </footer>
</body>
</html>
